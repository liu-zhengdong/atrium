FROM node:24.21.0-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6

# Use the same checked-in npm lock as the Web/runner, not the host's macOS modules.
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates gh ripgrep fd-find \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system url."https://github.com/".insteadOf ssh://git@github.com/
WORKDIR /opt/atrium
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund \
    && test -f node_modules/@liuser/pi-atrium/dist/index.js \
    && test -f node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js
COPY docker/agent-helper.mjs /opt/atrium/agent-helper.mjs

ENV PATH="/opt/atrium/node_modules/.bin:${PATH}"
USER node
ENTRYPOINT ["node", "/opt/atrium/node_modules/@liuser/pi-atrium/dist/index.js"]
