{
  "name": "atrium",
  "version": "0.1.79",
  "private": true,
  "type": "module",
  "bin": {
    "atrium": "bin/atrium.mjs"
  },
  "files": [
    "bin",
    "cli",
    "server",
    "shared",
    "releases.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "build": "tsc --noEmit",
    "start": "tsx server/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@zed-industries/codex-acp": "0.16.0",
    "fastify": "^5.12.5",
    "tsx": "^4.23.13",
    "yaml": "2.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "prettier": "3.9.7",
    "typescript": "^7.0.2"
  }
}
