{
  "name": "atrium",
  "version": "0.1.35",
  "private": true,
  "type": "module",
  "bin": {
    "atrium": "bin/atrium.mjs"
  },
  "files": [
    "bin",
    "cli",
    "server",
    "shared",
    "dist",
    "releases.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k 'tsx watch server/main.ts' 'vite --host 127.0.0.1'",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test",
    "test:pi": "node --import tsx scripts/probe-pi.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@clack/prompts": "^1.8.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@fastify/static": "^10.1.3",
    "@liuser/pi-atrium": "github:liu-zhengdong/pi-atrium#c29ed1f1e0e6e8aa0f513fe6b982092be359e48d",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@tanstack/react-virtual": "^3.14.13",
    "fastify": "^5.12.5",
    "lucide-react": "^1.46.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.13",
    "vite": "^8.3.0",
    "ws": "^8.21.3",
    "yaml": "2.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "prettier": "3.9.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
