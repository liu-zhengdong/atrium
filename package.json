{
  "name": "atrium",
  "version": "0.1.134",
  "private": true,
  "type": "module",
  "bin": {
    "atrium": "bin/atrium.mjs"
  },
  "files": [
    "bin",
    "dist",
    "server/map/web",
    "releases.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "build": "tsc --noEmit",
    "dist": "node scripts/build-dist.mjs",
    "prepack": "node scripts/build-dist.mjs --prepack",
    "start": "tsx server/main.ts",
    "test": "tsx tests/run-tests.ts",
    "check": "npm run build && npm test",
    "bench:cli": "node scripts/build-dist.mjs && node scripts/bench-cli.mjs",
    "e2e": "node scripts/e2e-main-path.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@zed-industries/codex-acp": "0.16.0",
    "fastify": "^5.12.5",
    "yaml": "2.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "esbuild": "^0.28.2",
    "prettier": "3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
